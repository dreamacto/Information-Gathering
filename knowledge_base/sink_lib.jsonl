{"category": "authz_missing", "lang": "js", "pattern": "session(?:s)?\\.(?:userId|uid|user_id)\\s*=\\s*req\\.", "severity": "high", "note": "会话身份可被请求覆盖"}
{"category": "authz_missing", "lang": "js", "pattern": "/api/(?:admin|internal|debug|test)/", "severity": "medium", "note": "内部 API 路径"}
{"category": "authz_missing", "lang": "js", "pattern": "checkLogin\\s*\\(\\s*\\)\\s*\\{\\s*return\\s+true", "severity": "high", "note": "登录校验恒真"}
{"category": "authz_missing", "lang": "js", "pattern": "permission\\s*[:=]\\s*(?:0|false|none)", "severity": "low", "note": "权限字段弱值"}
