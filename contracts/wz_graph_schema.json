{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wz_graph_schema",
  "title": "WZ specialized orchestration graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["graph_id", "assessment_id", "workflow", "nodes", "edges", "created_at"],
  "properties": {
    "graph_id": {"type": "string", "pattern": "^graph_"},
    "assessment_id": {"type": "string", "minLength": 1},
    "workflow": {"const": "wz"},
    "graph_version": {"const": "1.0"},
    "created_at": {"type": "string", "minLength": 1},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind", "phase", "order"],
      "properties": {
        "node_id": {"type": "string", "pattern": "^node_[A-Za-z0-9._-]+$"},
        "kind": {"enum": ["task", "worker", "gate", "checkpoint", "approval", "verifier"]},
        "phase": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 0},
        "join": {"enum": ["all", "any", "barrier"]},
        "cursor_file": {"const": "phase_status.json"},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "retry_limit": {"type": "integer", "minimum": 0},
        "cancellable": {"type": "boolean"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "from", "to", "kind"],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "from": {"type": "string", "pattern": "^node_"},
        "to": {"type": "string", "pattern": "^node_"},
        "kind": {"enum": ["depends_on", "produces", "gates", "joins"]}
      }
    }
  },
  "x-wz-application-mapping": {
    "subphases": ["graphql_mapping", "websocket_mapping", "file_surface_mapping", "auth_surface_mapping", "webhook_mapping"],
    "reconciliation": "application_mapping_reconciliation",
    "terminal_chain": ["approval", "verifier"],
    "status_file": "phase_status.json",
    "forbidden_cursors": ["phase_status.miniapp.json", "run_status.json"]
  }
}
