{
  "schema_version": "1.0",
  "contract": "graph",
  "description": "Assessment DAG of tasks, workers and control gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["graph_id", "assessment_id", "workflow", "nodes", "edges", "created_at"],
  "properties": {
    "graph_id": {"type": "string", "pattern": "^graph_[A-Za-z0-9._-]+$"}, "assessment_id": {"type": "string"}, "workflow": {"type": "string", "enum": ["wz", "xcx", "fh"]},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "phase", "order"], "properties": {"node_id": {"type": "string", "pattern": "^node_[A-Za-z0-9._-]+$"}, "kind": {"type": "string", "enum": ["task", "worker", "gate", "checkpoint", "approval", "verifier"]}, "phase": {"type": "string"}, "order": {"type": "integer", "minimum": 0}, "join": {"type": "string", "enum": ["all", "any", "barrier"]}, "cursor_file": {"type": ["string", "null"], "enum": ["phase_status.json", "phase_status.miniapp.json", null]}, "timeout_seconds": {"type": "integer", "minimum": 1}, "retry_limit": {"type": "integer", "minimum": 0}, "cancellable": {"type": "boolean"}}}},
    "edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["edge_id", "from", "to", "kind"], "properties": {"edge_id": {"type": "string"}, "from": {"type": "string"}, "to": {"type": "string"}, "kind": {"type": "string", "enum": ["depends_on", "produces", "gates", "joins"]}}}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "invariants": ["node IDs are unique and all edge endpoints exist", "graph is acyclic", "WZ nodes bind only phase_status.json and XCX nodes only phase_status.miniapp.json", "scope, approval and verifier are explicit control nodes"]
}
